[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.89"
default-run = "{{project-name}}"
publish = false

[workspace]
{% if layout == "modular" -%}
resolver = "3"

[workspace.dependencies]
che-orm = { version = "0.5.0", default-features = false }
{% endif %}

[features]
default = ["{{backend}}"]
sqlite = ["che-orm/sqlite"]
postgres = ["che-orm/postgres"]

[dependencies]
{% if layout == "modular" -%}
che-orm.workspace = true
app_tasks = { package = "{{project-name}}-app-tasks", path = "apps/tasks" }
toml_edit = "0.25"
{% else -%}
che-orm = { version = "0.5.0", default-features = false }
{% endif -%}
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
